	usb0_id_det = <&pio 5 6 GPIO_ACTIVE_HIGH>;
	status = "okay";
};
&ehci0 {
	status = "okay";
};
//&ohci0 {
//	status = "okay";
//};*/

//otg peripheral:
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};
&usbphy {
	//usb0_id_det = <&pio 5 6 GPIO_ACTIVE_HIGH>;
	/delete-property/ usb0_id_det;
    /delete-property/ usb0_vbus_det;
    /delete-property/ usb0_vbus-supply;

	status = "okay";
};
&ehci0 {
	status = "disabled";
};
&ohci0 {
	status = "disabled";
};



/* =================================================================
 * 音频配置区域 (已启用)
 * ================================================================= */

&codec {
	allwinner,audio-routing =
		"Headphone", "HP",
		"Headphone", "HPCOM",
		"MIC1", "Mic",
		"Mic",  "HBIAS";
	status = "okay";
};

/* 模拟通路也需要开启 */
&codec_analog {
	status = "okay";
};

/* =================================================================
 * 其他外设配置
 * ================================================================= */

&mmc0 {
	broken-cd;
	bus-width = <4>;
	vmmc-supply = <&reg_vcc3v3>;
	status = "okay";
};

/* MMC1 与 LED 冲突，且 Dock 通常不用，保持禁用 */
&mmc1 {
	status = "disabled";
};

&uart0 {
	pinctrl-0 = <&uart0_pb_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&emac {
	phy-handle = <&int_mii_phy>;
	phy-mode = "mii";
	allwinner,leds-active-low;
	status = "okay";
};

